# Anything named NEXT_PUBLIC_* is inlined into the JavaScript sent to the
# browser. Treat every value below the divider as published the moment it
# is deployed. Everything above it must never gain that prefix.
#
# Verified against a production build: of the secrets here, only the anon
# key appears in .next/static. The service role key, sync secret, VAPID
# private key and Resend key appear in zero client chunks.

# --- secret: server-only, never sent to a browser -------------------------

# Bypasses row-level security entirely. The most dangerous value in this
# file -- it can read and write every table as any user.
SUPABASE_SERVICE_ROLE_KEY=

# Shared bearer for every scheduled job route (poll, the scrapers,
# welcome-email, admin-digest). Whoever holds it can mail your whole user
# base and drive the browser automation.
SYNC_SECRET=

# Signs web-push messages. Pairs with NEXT_PUBLIC_VAPID_PUBLIC_KEY below.
VAPID_PRIVATE_KEY=

# Required by the Web Push spec as a contact address for push services to
# reach you about a misbehaving sender. Use a role address if you have one --
# it's a real contact point, not a secret, but it's not published to browsers
# either, so it doesn't need to be hardcoded in source.
VAPID_SUBJECT=

RESEND_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=

# Where feedback lands, and the comma-separated allowlist that grants
# admin. An address here that has no account yet can be claimed by anyone
# if Supabase's "Confirm email" is off -- isAdminUser() additionally
# requires a confirmed email for exactly that reason.
FEEDBACK_TO_EMAIL=
ADMIN_EMAILS=
RESEND_FROM_EMAIL=

# --- public: shipped to the browser by design ----------------------------

NEXT_PUBLIC_SUPABASE_URL=

# Public by design, not a leak. It identifies the project and carries no
# privileges of its own -- everything it can do is whatever row-level
# security grants the `anon` and `authenticated` roles. That makes your
# RLS policies the entire security boundary for this key, which is why
# they belong in supabase/migrations rather than only in the SQL Editor.
#
# Used in three places: the cookie-scoped server client, the middleware
# session refresh, and the browser client. Only the last of those puts it
# in a client chunk, and the sole reason that chunk exists is
# GoogleSignInButton's PKCE flow.
#
# Prefer a modern `sb_publishable_...` key over a legacy `eyJ...` anon
# JWT if the project offers one: publishable keys can be revoked and
# rotated on their own, whereas rotating a legacy anon key means rotating
# the project JWT secret and signing every user out.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Distributed to browsers to register push subscriptions; the private half
# above is what actually signs.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

NEXT_PUBLIC_SITE_URL=
