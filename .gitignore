# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# editors
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local link state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local project memory (working agreement, not for commit)
CLAUDE.md

# regenerated by `next dev` on every run, not meaningful project content
AGENTS.md

# local Claude Code permission settings, machine-specific
.claude/

/docs/HISTORY.md

# Security audit record. Same treatment as HISTORY.md, and for one extra
# reason: it lists the findings that are still OPEN, with file and line.
# In a public repo fronting a live site that is a roadmap, not a changelog.
/docs/SECURITY-CHANGES.md

# Impeccable design skill's own scratch output (screenshots, generated
# comps) -- .impeccable/config.json itself stays tracked, this only
# ignores the working directories the skill writes during a session.
.impeccable/review/
.impeccable/mocks/